import YangMills.RG.BalabanCMP99SourceGaugeRegularScalePair
import YangMills.RG.BalabanCMP99SourceWeightedPhysicalGaugeCovariance
import YangMills.RG.BalabanCMP99SourceGeneratedPoincareQprime

/-!
PRE-VALIDATION: source is present only in scratch; no `.olean` has been
materialized and none of the declarations below is compiler-verified.

# A jointly generated regular/small retained CMP99 tower

This is C6c.8c6--c7.  One private recursion constructs the tower on a regular
background together with the canonical tower on its small gauge
representative.  The recursion derives every coarse background and every
prefix intertwiner.  It never assumes smallness of the original background
and accepts no tower or operator equality from the caller.
-/

namespace YangMills.RG

open YangMills YangMills.GaugeConfig Matrix
open scoped Matrix.Norms.L2Operator

noncomputable section

variable {d M N Nc depth : ℕ}
variable [NeZero d] [NeZero M] [NeZero N] [NeZero Nc]

/-- Changing a background by equality does not create a second generated
tower.  The smallness certificates are propositions and hence proof
irrelevance closes the remaining arguments after substitution. -/
private theorem CMP99SourceActiveRegionChain.weightedQprimeTower_congr_background
    (regions : CMP99SourceActiveRegionChain d M N Omega depth)
    (hd : 2 ≤ d) (hM : 2 ≤ M) (rho : SUNAdjointModel Nc)
    (spacing epsilon : ℝ)
    {A B : GaugeConfig d N (SUN Nc)} (hAB : A = B)
    (chain : CMP99SourceUbarRadiusChain d M Nc depth epsilon)
    (smallA : ∀ e : ConcreteEdge d N,
      ‖(A e : Matrix (Fin Nc) (Fin Nc) ℂ) - 1‖ ≤ epsilon)
    (smallB : ∀ e : ConcreteEdge d N,
      ‖(B e : Matrix (Fin Nc) (Fin Nc) ℂ) - 1‖ ≤ epsilon) :
    regions.weightedQprimeTower hd hM rho spacing epsilon A chain smallA =
      regions.weightedQprimeTower hd hM rho spacing epsilon B chain smallB := by
  subst B
  rfl

/-- Every prefix of the regular tower and its small representative, together
with the terminal gauge isometry generated by the same physical recursion.
The constructor is private: in particular `prefixQprime_intertwines` cannot
be supplied independently of the two towers. -/
structure CMP99SourceGaugeTransportedRetainedPair
    (regions : CMP99SourceActiveRegionChain d M N Omega depth)
    (hd : 2 ≤ d) (hM : 2 ≤ M)
    (rho : SUNAdjointModel Nc)
    (spacing epsilon : ℝ)
    (background : GaugeConfig d N (SUN Nc))
    (u : GaugeTransform d N (SUN Nc))
    (chain : CMP99SourceUbarRadiusChain d M Nc depth epsilon)
    (transformedSmall : ∀ e : ConcreteEdge d N,
      ‖(gaugeAct u background e : Matrix (Fin Nc) (Fin Nc) ℂ) - 1‖ ≤
        epsilon) where
  private mk ::
  originalTowerAt : Fin (depth + 1) →
    CMP99SourceWeightedRegionalTower (g := SUNLieCoord Nc) Omega spacing
  transformedTowerAt : Fin (depth + 1) →
    CMP99SourceWeightedRegionalTower (g := SUNLieCoord Nc) Omega spacing
  originalTowerAt_depth : ∀ r, (originalTowerAt r).depth = r.val
  transformedTowerAt_depth : ∀ r, (transformedTowerAt r).depth = r.val
  originalTowerAt_zero : originalTowerAt 0 =
    CMP99SourceWeightedRegionalTower.stop
      (g := SUNLieCoord Nc) Omega spacing
  transformedTowerAt_zero : transformedTowerAt 0 =
    CMP99SourceWeightedRegionalTower.stop
      (g := SUNLieCoord Nc) Omega spacing
  prefixGauge : ∀ r,
    (originalTowerAt r).TerminalSpace.carrier ≃ₗᵢ[ℝ]
      (transformedTowerAt r).TerminalSpace.carrier
  prefixGauge_zero : prefixGauge 0 =
    cmp99RegionalFineGaugeLinearIsometryEquiv Omega rho u
  /-- Multiscale CMP99 (3.32), at every retained prefix. -/
  prefixQprime_intertwines : ∀ r,
    (transformedTowerAt r).Qprime.comp
        (cmp99RegionalFineGaugeLinearIsometryEquiv Omega rho u :
          ActiveGaugeZeroCochain Omega (SUNLieCoord Nc) →L[ℝ]
            ActiveGaugeZeroCochain Omega (SUNLieCoord Nc)) =
      (prefixGauge r :
        (originalTowerAt r).TerminalSpace.carrier →L[ℝ]
          (transformedTowerAt r).TerminalSpace.carrier).comp
        (originalTowerAt r).Qprime
  /-- The transformed terminal member is the existing canonical source
  tower, not a separately chosen isomorphic copy. -/
  transformedTerminal_eq_generated :
    transformedTowerAt (Fin.last depth) =
      regions.weightedQprimeTower hd hM rho spacing epsilon
        (gaugeAct u background) chain transformedSmall

/-- Source-facing producer of the paired retained tower.  Its only linkwise
smallness input is the one for `gaugeAct u background` supplied by CMP99
(3.35).  All original-side deviation bounds, Ubar backgrounds and prefix
intertwiners are generated internally. -/
noncomputable def cmp99SourceGaugeTransportedRetainedPair
    (regions : CMP99SourceActiveRegionChain d M N Omega depth)
    (hd : 2 ≤ d) (hM : 2 ≤ M) (rho : SUNAdjointModel Nc) :
    letI : NeZero N := regions.neZero
    (spacing epsilon : ℝ) →
    (background : GaugeConfig d N (SUN Nc)) →
    (u : GaugeTransform d N (SUN Nc)) →
    (chain : CMP99SourceUbarRadiusChain d M Nc depth epsilon) →
    (transformedSmall : ∀ e : ConcreteEdge d N,
      ‖(gaugeAct u background e : Matrix (Fin Nc) (Fin Nc) ℂ) - 1‖ ≤
        epsilon) →
    CMP99SourceGaugeTransportedRetainedPair regions hd hM rho spacing epsilon
      background u chain transformedSmall := by
  letI : NeZero N := regions.neZero
  intro spacing epsilon background u chain transformedSmall
  induction regions generalizing spacing epsilon with
  | stop Omega =>
      let stopTower := CMP99SourceWeightedRegionalTower.stop
        (g := SUNLieCoord Nc) Omega spacing
      let topGauge := cmp99RegionalFineGaugeLinearIsometryEquiv Omega rho u
      refine CMP99SourceGaugeTransportedRetainedPair.mk
        (fun _ => stopTower) (fun _ => stopTower) ?_ ?_ rfl rfl
        (fun _ => topGauge) rfl ?_ rfl
      · intro r
        have hr : r = 0 := Fin.eq_zero r
        subst r
        rfl
      · intro r
        have hr : r = 0 := Fin.eq_zero r
        subst r
        rfl
      · intro r
        have hr : r = 0 := Fin.eq_zero r
        subst r
        change (ContinuousLinearMap.id ℝ _).comp
            (topGauge : _ →L[ℝ] _) =
          (topGauge : _ →L[ℝ] _).comp (ContinuousLinearMap.id ℝ _)
        simp
  | @step N' tailDepth _ Omega blockSaturated tail ih =>
      letI : NeZero (M * N') := inferInstance
      let ScalePair := cmp99SourceGaugeRegularScalePair hd hM Omega
        background blockSaturated u epsilon chain.epsilon_nonneg
        chain.head_noWinding transformedSmall
      have nextTransformedSmall : ∀ e : ConcreteEdge d N',
          ‖(gaugeAct (coarseTransform u) ScalePair.originalData.nextBackground e :
              Matrix (Fin Nc) (Fin Nc) ℂ) - 1‖ ≤
            cmp99SourceUbarNextFineRadius d M epsilon := by
        intro e
        rw [← ScalePair.nextBackground_gaugeAct]
        exact
          cmp99SourceGaugeRegularScalePair_transformed_nextBackground_small
            hd hM Omega background blockSaturated u epsilon
            chain.epsilon_nonneg chain.head_noWinding chain.head_logSmall
            transformedSmall e
      let Tail := ih ((M : ℝ) * spacing)
        (cmp99SourceUbarNextFineRadius d M epsilon)
        ScalePair.originalData.nextBackground (coarseTransform u) chain.tail
        nextTransformedSmall
      let originalHead := CMP99SourceWeightedRegionalTower.stop
        (g := SUNLieCoord Nc) Omega spacing
      let transformedHead := CMP99SourceWeightedRegionalTower.stop
        (g := SUNLieCoord Nc) Omega spacing
      let originalSucc (r : Fin (tailDepth + 1)) :=
        CMP99SourceWeightedRegionalTower.step
          (g := SUNLieCoord Nc) Omega blockSaturated spacing
          (cmp99SourceWeightedPhysicalTransport rho background)
          (Tail.originalTowerAt r)
      let transformedSucc (r : Fin (tailDepth + 1)) :=
        CMP99SourceWeightedRegionalTower.step
          (g := SUNLieCoord Nc) Omega blockSaturated spacing
          (cmp99SourceWeightedPhysicalTransport rho (gaugeAct u background))
          (Tail.transformedTowerAt r)
      let originalTower : Fin (tailDepth + 2) →
          CMP99SourceWeightedRegionalTower
            (g := SUNLieCoord Nc) Omega spacing :=
        Fin.cases originalHead originalSucc
      let transformedTower : Fin (tailDepth + 2) →
          CMP99SourceWeightedRegionalTower
            (g := SUNLieCoord Nc) Omega spacing :=
        Fin.cases transformedHead transformedSucc
      let prefixGauge : ∀ r : Fin (tailDepth + 2),
          (originalTower r).TerminalSpace.carrier ≃ₗᵢ[ℝ]
            (transformedTower r).TerminalSpace.carrier := by
        intro r
        refine Fin.cases ?_ (fun s => ?_) r
        · exact cmp99RegionalFineGaugeLinearIsometryEquiv Omega rho u
        · exact Tail.prefixGauge s
      have prefixIntertwines : ∀ r : Fin (tailDepth + 2),
          (transformedTower r).Qprime.comp
              (cmp99RegionalFineGaugeLinearIsometryEquiv Omega rho u :
                ActiveGaugeZeroCochain Omega (SUNLieCoord Nc) →L[ℝ]
                  ActiveGaugeZeroCochain Omega (SUNLieCoord Nc)) =
            (prefixGauge r :
              (originalTower r).TerminalSpace.carrier →L[ℝ]
                (transformedTower r).TerminalSpace.carrier).comp
              (originalTower r).Qprime := by
        intro r
        refine Fin.cases ?_ (fun s => ?_) r
        · change (ContinuousLinearMap.id ℝ _).comp
              (cmp99RegionalFineGaugeLinearIsometryEquiv Omega rho u :
                _ →L[ℝ] _) =
            (cmp99RegionalFineGaugeLinearIsometryEquiv Omega rho u :
              _ →L[ℝ] _).comp (ContinuousLinearMap.id ℝ _)
          simp
        · let QT := cmp99SourceTransportedBlockAverageCLM Omega
            (cmp99SourceWeightedPhysicalTransport rho (gaugeAct u background))
          let Q := cmp99SourceTransportedBlockAverageCLM Omega
            (cmp99SourceWeightedPhysicalTransport rho background)
          let GF := cmp99RegionalFineGaugeLinearIsometryEquiv Omega rho u
          let GC := cmp99RegionalCoarseGaugeLinearIsometryEquiv Omega rho u
          have hhead : QT.comp (GF : _ →L[ℝ] _) =
              (GC : _ →L[ℝ] _).comp Q :=
            cmp99SourceTransportedBlockAverageCLM_weightedPhysicalTransport_comp_gaugeIsometry
              Omega rho u background
          have htail := Tail.prefixQprime_intertwines s
          rw [cmp99RegionalCoarseGaugeLinearIsometryEquiv_eq_fine_coarseTransform]
              at hhead
          change ((Tail.transformedTowerAt s).Qprime.comp QT).comp
              (GF : _ →L[ℝ] _) =
            (Tail.prefixGauge s : _ →L[ℝ] _).comp
              ((Tail.originalTowerAt s).Qprime.comp Q)
          calc
            ((Tail.transformedTowerAt s).Qprime.comp QT).comp
                (GF : _ →L[ℝ] _) =
              (Tail.transformedTowerAt s).Qprime.comp
                (QT.comp (GF : _ →L[ℝ] _)) := by
                  rw [ContinuousLinearMap.comp_assoc]
            _ = (Tail.transformedTowerAt s).Qprime.comp
                ((cmp99RegionalFineGaugeLinearIsometryEquiv
                    (cmp99ActiveCoarseRegion (M := M) (N' := N') Omega)
                    rho (coarseTransform u) : _ →L[ℝ] _).comp Q) := by
                  rw [hhead]
            _ = ((Tail.transformedTowerAt s).Qprime.comp
                  (cmp99RegionalFineGaugeLinearIsometryEquiv
                    (cmp99ActiveCoarseRegion (M := M) (N' := N') Omega)
                    rho (coarseTransform u) : _ →L[ℝ] _)).comp Q := by
                  rw [ContinuousLinearMap.comp_assoc]
            _ = ((Tail.prefixGauge s : _ →L[ℝ] _).comp
                  (Tail.originalTowerAt s).Qprime).comp Q := by
                  rw [htail]
            _ = (Tail.prefixGauge s : _ →L[ℝ] _).comp
                ((Tail.originalTowerAt s).Qprime.comp Q) := by
                  rw [ContinuousLinearMap.comp_assoc]
      refine CMP99SourceGaugeTransportedRetainedPair.mk
        originalTower transformedTower ?_ ?_ rfl rfl prefixGauge rfl
        prefixIntertwines ?_
      · intro r
        refine Fin.cases ?_ (fun s => ?_) r
        · rfl
        · change (originalSucc s).depth = s.succ.val
          rw [CMP99SourceWeightedRegionalTower.depth_step,
            Tail.originalTowerAt_depth]
          rfl
      · intro r
        refine Fin.cases ?_ (fun s => ?_) r
        · rfl
        · change (transformedSucc s).depth = s.succ.val
          rw [CMP99SourceWeightedRegionalTower.depth_step,
            Tail.transformedTowerAt_depth]
          rfl
      · let CanonicalScaleT := cmp99SourceRegionalScaleDataOfFineSmall
          hd hM Omega (gaugeAct u background)
          (cmp99SourceBlockAverageWeight M d) epsilon chain.epsilon_nonneg
          chain.head_noWinding transformedSmall
        have hdata : CanonicalScaleT = ScalePair.transformedData := by
          rfl
        have hbackground : CanonicalScaleT.nextBackground =
            gaugeAct (coarseTransform u) ScalePair.originalData.nextBackground :=
          (congrArg (fun D => D.nextBackground) hdata).trans
            ScalePair.nextBackground_gaugeAct
        have canonicalNextSmall : ∀ e : ConcreteEdge d N',
            ‖(CanonicalScaleT.nextBackground e :
                Matrix (Fin Nc) (Fin Nc) ℂ) - 1‖ ≤
              cmp99SourceUbarNextFineRadius d M epsilon := by
          intro e
          exact
            norm_cmp99SourceRegionalScaleDataOfFineSmall_nextBackground_sub_one_le
              hd hM Omega (gaugeAct u background)
              (cmp99SourceBlockAverageWeight M d) epsilon
              chain.epsilon_nonneg chain.head_noWinding chain.head_logSmall
              transformedSmall e
        have htailGenerated :
            Tail.transformedTowerAt (Fin.last tailDepth) =
              tail.weightedQprimeTower hd hM rho ((M : ℝ) * spacing)
                (cmp99SourceUbarNextFineRadius d M epsilon)
                CanonicalScaleT.nextBackground chain.tail
                canonicalNextSmall := by
          exact Tail.transformedTerminal_eq_generated.trans
            (tail.weightedQprimeTower_congr_background hd hM rho
              ((M : ℝ) * spacing)
              (cmp99SourceUbarNextFineRadius d M epsilon)
              hbackground chain.tail canonicalNextSmall
              nextTransformedSmall).symm
        have hlast : Fin.last (tailDepth + 1) =
            (Fin.last tailDepth).succ := by
          apply Fin.ext
          simp
        rw [hlast]
        change transformedSucc (Fin.last tailDepth) =
          CMP99SourceWeightedRegionalTower.step
            (g := SUNLieCoord Nc) Omega blockSaturated spacing
            (cmp99SourceWeightedPhysicalTransport rho (gaugeAct u background))
            (tail.weightedQprimeTower hd hM rho ((M : ℝ) * spacing)
              (cmp99SourceUbarNextFineRadius d M epsilon)
              CanonicalScaleT.nextBackground chain.tail canonicalNextSmall)
        exact congrArg
          (CMP99SourceWeightedRegionalTower.step
            (g := SUNLieCoord Nc) Omega blockSaturated spacing
            (cmp99SourceWeightedPhysicalTransport rho (gaugeAct u background)))
          htailGenerated

/-- Terminal specialization of the internally derived multiscale
intertwiner. -/
theorem CMP99SourceGaugeTransportedRetainedPair.terminalQprime_intertwines
    {Omega : ActiveGaugeRegion d N}
    {regions : CMP99SourceActiveRegionChain d M N Omega depth}
    {hd : 2 ≤ d} {hM : 2 ≤ M} {rho : SUNAdjointModel Nc}
    {spacing epsilon : ℝ} {background : GaugeConfig d N (SUN Nc)}
    {u : GaugeTransform d N (SUN Nc)}
    {chain : CMP99SourceUbarRadiusChain d M Nc depth epsilon}
    {transformedSmall : ∀ e : ConcreteEdge d N,
      ‖(gaugeAct u background e : Matrix (Fin Nc) (Fin Nc) ℂ) - 1‖ ≤
        epsilon}
    (T : CMP99SourceGaugeTransportedRetainedPair regions hd hM rho spacing
      epsilon background u chain transformedSmall) :
    (T.transformedTowerAt (Fin.last depth)).Qprime.comp
        (cmp99RegionalFineGaugeLinearIsometryEquiv Omega rho u :
          ActiveGaugeZeroCochain Omega (SUNLieCoord Nc) →L[ℝ]
            ActiveGaugeZeroCochain Omega (SUNLieCoord Nc)) =
      (T.prefixGauge (Fin.last depth) :
        (T.originalTowerAt (Fin.last depth)).TerminalSpace.carrier →L[ℝ]
          (T.transformedTowerAt (Fin.last depth)).TerminalSpace.carrier).comp
        (T.originalTowerAt (Fin.last depth)).Qprime :=
  T.prefixQprime_intertwines (Fin.last depth)

end

end YangMills.RG
