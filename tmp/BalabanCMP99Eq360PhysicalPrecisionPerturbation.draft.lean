import YangMills.RG.BalabanCMP99SourceGaugePrecision

/-!
PRE-VALIDATION: this scratch source has no materialized `.olean` and no
compiler or axiom-oracle verdict.

# CMP99 (3.59)--(3.60): exact real-slice precision perturbation

On the physical real slice, the two physical averaging operators determine
`F2 := Q1 - Q0` internally; no `F2` family is accepted from the caller.
Expanding `Delta1 + a Q1^* Q1` then gives exactly the four-term perturbation
printed in CMP99 (3.60).  The three averaging terms remain separate; no common
norm budget or analytic estimate is introduced here.

This module intentionally concerns the real Hilbert adjoint.  CMP99 warns
that the analytically continued symbol `F2*` is not obtained by taking a
complex Hilbert adjoint away from the real slice; that later complexification
dictionary is not claimed here.
-/

namespace YangMills.RG

open scoped RealInnerProductSpace

noncomputable section

/-- Literal real-slice `F'_2(A)` from (3.59), determined by the perturbed and
baseline physical averaging operators rather than supplied as a datum. -/
def cmp99Eq359PhysicalQprimePerturbation
    {E F : Type*}
    [SeminormedAddCommGroup E] [NormedSpace ℝ E]
    [SeminormedAddCommGroup F] [NormedSpace ℝ F]
    (Q0 Q1 : E →L[ℝ] F) : E →L[ℝ] F :=
  Q1 - Q0

/-- Literal physical `V'(A)` from (3.60): the Laplacian perturbation minus
the three terms generated by `Q1 = Q0 + F2`. -/
def cmp99Eq360PhysicalPrecisionPerturbation
    {E F : Type*}
    [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    [NormedAddCommGroup F] [InnerProductSpace ℝ F] [CompleteSpace F]
    (Delta0 Delta1 : E →L[ℝ] E) (Q0 Q1 : E →L[ℝ] F) (a : ℝ) :
    E →L[ℝ] E :=
  let F2 := cmp99Eq359PhysicalQprimePerturbation Q0 Q1
  (Delta0 - Delta1) - a • (F2.adjoint.comp Q0) -
    a • (Q0.adjoint.comp F2) - a • (F2.adjoint.comp F2)

/-- Exact equation (3.60) on the physical real slice.  It is pure operator
algebra and assumes neither a perturbation bound nor invertibility. -/
theorem cmp99Eq360_sourceGaugePrecision_eq_sub_perturbation
    {E F : Type*}
    [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    [NormedAddCommGroup F] [InnerProductSpace ℝ F] [CompleteSpace F]
    (Delta0 Delta1 : E →L[ℝ] E) (Q0 Q1 : E →L[ℝ] F) (a : ℝ) :
    cmp99SourceGaugePrecision Delta1 Q1 a =
      cmp99SourceGaugePrecision Delta0 Q0 a -
        cmp99Eq360PhysicalPrecisionPerturbation
          Delta0 Delta1 Q0 Q1 a := by
  apply ContinuousLinearMap.ext
  intro phi
  simp only [cmp99SourceGaugePrecision,
    cmp99Eq359PhysicalQprimePerturbation,
    cmp99Eq360PhysicalPrecisionPerturbation,
    ContinuousLinearMap.add_apply, ContinuousLinearMap.sub_apply,
    ContinuousLinearMap.smul_apply, ContinuousLinearMap.comp_apply,
    ContinuousLinearMap.adjoint.map_sub]
  module

/-- Equivalent factorized form of (3.62), before any inverse is introduced.
If `G0` is a left inverse of the unperturbed precision, the perturbed
precision equals `(I - V G0) K0`. -/
theorem cmp99Eq362_precision_eq_one_sub_perturbation_comp_of_leftInverse
    {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (K0 K1 V G0 : E →L[ℝ] E)
    (hK1 : K1 = K0 - V)
    (hG0 : G0.comp K0 = ContinuousLinearMap.id ℝ E) :
    K1 = (ContinuousLinearMap.id ℝ E - V.comp G0).comp K0 := by
  rw [hK1]
  apply ContinuousLinearMap.ext
  intro phi
  simp only [ContinuousLinearMap.sub_apply, ContinuousLinearMap.comp_apply,
    ContinuousLinearMap.id_apply]
  have happ := DFunLike.congr_fun hG0 phi
  simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.id_apply]
    at happ
  rw [happ]

end

end YangMills.RG
