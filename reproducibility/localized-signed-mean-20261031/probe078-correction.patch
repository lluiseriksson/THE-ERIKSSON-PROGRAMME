+theorem localizedSignedMean_fixed_output_family {d Nc : ℕ} [NeZero d] [NeZero Nc]
+    (rho : SUNAdjointModel Nc) :
+    ∀ k : ℕ, ∃ (w : PhysicalGradientIndex d (k+1) → ℝ)
+      (C : PhysicalGaugeOneCochain d (k+1) Nc →L[ℝ] SignedMeanObservation d Nc)
