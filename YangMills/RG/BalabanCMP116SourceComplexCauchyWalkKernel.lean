        (A * Rweak ^ 10000) *
          (1 - (branching : ℝ) * rho * Rweak ^ 10000)⁻¹ := by
    exact (Summable.tsum_le_tsum
      (fun walk => mul_le_mul_of_nonneg_left (hcoefficient walk)
        (pow_nonneg (zero_le_one.trans hRweak) _))
      hradialCoefficient hradialValue).trans hclosedValue
  have hboundary :=
