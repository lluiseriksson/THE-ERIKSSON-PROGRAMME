      emb radius
      (fun walk : CMP99AnchoredWalk successors left =>
        walk.active Dict.domainActive)
      (fun walk => cmp116ComplexPhysicalOperatorCoefficient
        (term walk) source target input output)
      Rweak hRweak hcap hradialCoefficient
  apply CMP116Eq214CauchyBoundaryBound.mono n radius _ _ hboundary
  simpa [A, Ahead, rho, branching, mul_assoc] using hclosedCoefficient

