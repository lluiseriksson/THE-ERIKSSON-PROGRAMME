import YangMills.RG.BalabanCMP95PeriodicCutoffSlope
import YangMills.RG.BalabanCMP99SourceGeneratedRegionalFinePartition

/-!
# The auxiliary generated cutoff slope on the regional fine carrier

Compiler-verified at source checkpoint
`837040284f5ce1d358d42eb8f6c01689829db29b` in durable GitHub Actions run
`30971247380`.  The focal completed 8,514 jobs and both audited declarations
use exactly `[propext, Classical.choice, Quot.sound]`.

This file transports the terminal-scale CMP95 slope through the canonical
equality of the recursive and factored fine-lattice sides.  The transport is
isometric for `finBoxDist`; no second overlap or coordinate-comparison
constant is introduced.  Since the cutoff spacing is only twice the certified
precision range, this exact auxiliary theorem is not the physical source
`M⁻¹` estimate in CMP99 (3.89).
-/

namespace YangMills.RG

noncomputable section

variable {M Q depth : ℕ} [NeZero M] [NeZero Q]

/-- The canonical cast from the factored fine carrier to the recursively
generated carrier preserves the physical torus distance exactly. -/
theorem finBoxDist_cmp99RegionalFactoredToGeneratedFineSite
    (x y : FinBox 4 (M ^ (depth + 1) * (2 * Q))) :
    finBoxDist
        (cmp99RegionalFactoredToGeneratedFineSite
          (M := M) (Q := Q) (depth := depth) x)
        (cmp99RegionalFactoredToGeneratedFineSite
          (M := M) (Q := Q) (depth := depth) y) =
      finBoxDist x y := by
  let hsize : M ^ (depth + 1) * (2 * Q) =
      cmp99RegionalLatticeSize M (2 * Q) (depth + 1) :=
    (cmp99RegionalLatticeSize_eq_pow_mul M (2 * Q) (depth + 1)).symm
  have hx : cmp99RegionalFactoredToGeneratedFineSite
      (M := M) (Q := Q) (depth := depth) x = hsize ▸ x := by
    funext i
    apply Fin.ext
    change (x i).val = ((hsize ▸ x) i).val
    exact (finBox_cast_apply_val hsize x i).symm
  have hy : cmp99RegionalFactoredToGeneratedFineSite
      (M := M) (Q := Q) (depth := depth) y = hsize ▸ y := by
    funext i
    apply Fin.ext
    change (y i).val = ((hsize ▸ y) i).val
    exact (finBox_cast_apply_val hsize y i).symm
  rw [hx, hy]
  exact finBoxDist_cast_size hsize x y

/-- Literal inverse-spacing slope of the auxiliary `value` field.  The
constant `8` is generated by four coordinates and the two-translate
one-dimensional estimate; it is not supplied by the caller. -/
theorem
    norm_cmp99SourceGeneratedRegionalFineSquarePartition_value_sub_le
    (P : CMP95SourceSmoothPartitionProfile)
    (cell : FinBox 4 Q)
    (x y : FinBox 4 (M ^ (depth + 1) * (2 * Q))) :
    ‖(cmp99SourceGeneratedRegionalFineSquarePartition
          (M := M) (Q := Q) (depth := depth) P).value cell y -
        (cmp99SourceGeneratedRegionalFineSquarePartition
          (M := M) (Q := Q) (depth := depth) P).value cell x‖ ≤
      ((8 * P.derivBound) /
        cmp99SourceGeneratedCellCutoffScale M depth) *
        (finBoxDist x y : ℝ) := by
  have h := norm_cmp99SourceGeneratedFineCellCutoff_finBox_sub_le
    P M Q depth cell
      (cmp99RegionalFactoredToGeneratedFineSite
        (M := M) (Q := Q) (depth := depth) x)
      (cmp99RegionalFactoredToGeneratedFineSite
        (M := M) (Q := Q) (depth := depth) y)
  rw [finBoxDist_cmp99RegionalFactoredToGeneratedFineSite
    (M := M) (Q := Q) (depth := depth) x y] at h
  simpa [cmp99SourceGeneratedRegionalFineSquarePartition] using h

end

end YangMills.RG
