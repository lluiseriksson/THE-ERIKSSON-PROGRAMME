/-- Identifies a pre-`(1.36)` record with the literal direct/native ledger.
These equalities prevent the finalizer from accepting an arbitrary residual,
domain dictionary, kernel support, amplitude, cutoff threshold, or interaction
coefficient.  The last equality is the canonical minimal choice allowed by
the interaction budget; it is a normalization, not an estimate of
`root_small` or `outer_small`. -/
structure CMP116CenteredConditionedCombinedEq80LedgerIdentification
    {Index : Type*} {nDelta M Q Nc n L lieDim : ℕ}
    [NeZero M] [NeZero Q] [NeZero Nc] [NeZero (Nc ^ 2 - 1)]
    [NeZero (2 * Q)] [NeZero (M * (2 * Q))] [NeZero L] [NeZero lieDim]
    (Dict : PhysicalGaugeCMP116Dictionary
      4 (M * (2 * Q)) Nc 4 L lieDim)
    (P : Finset (CombinedConstructorBond M Q))
    (Z : Finset (FinBox 4 (2 * Q)))
    (anchor : FinBox 4 Q)
    (domains : Finset (CMP102Eq80SourcePi4PhysicalDomainLabel anchor))
    (E : CMP109LocalizedActionExpansion Index 2 (M * (2 * Q)) Nc)
    (V : PhysicalGaugeBackground 4 (M * (2 * Q)) Nc)
    (baseCoarseCovariance :
      CombinedConstructorCoarseField Q Nc →L[ℝ]
        CombinedConstructorCoarseField Q Nc)
    (layerWord : Fin n → ℕ)
    (D D₃ : CombinedConstructorFineField M Q Nc →
      CombinedConstructorCoarseField Q Nc)
    (V₀ : CombinedConstructorFineField M Q Nc → ℝ)
    (Pprop T : CombinedConstructorRectangularFieldMap M Q Nc)
    (DeltaPi : CombinedConstructorFineField M Q Nc →L[ℝ]
      CombinedConstructorFineField M Q Nc)
    (J : CombinedConstructorFineField M Q Nc)
    (E0Direct : ℝ)
    (S : CMP116Eq226CenteredConditionedPhysicalTermSourcePreEq136
      (nDelta := nDelta)
      (nY := CMP116Eq80Lemma1CombinedDomainCount anchor domains E)
      Dict
      (cmp116Eq80Lemma1CombinedSourceSmallFieldCarrier anchor domains E)
      P (cmp116Eq80Lemma1CombinedCenteredRegion anchor domains E P) Z)
    (choice : CMP99SourcePi4CoarseFineWalkChoice
      M Q S.sourceRange layerWord)
    (lemma1 : CMP109Lemma1Eq136SourceCertificate (q := S.q)
      E V S.gk D S.epsilon1 S.C1 S.C2 S.kappa1 S.delta S.kappa) : Prop where
  total_eq :
    S.total =
      cmp116CenteredConditionedCombinedEq80PartialTotal
        S.base.spectatorSupport S.base.fluctuationSupport anchor domains E V
        S.contourCarrier S.contourEquiv S.K S.coercivity_pos S.mass_pos
        S.K_coercive baseCoarseCovariance layerWord choice D D₃ V₀ Pprop T
        DeltaPi J S.gk
  residual_eq :
    S.residual =
      cmp116CenteredConditionedCombinedEq80PartialResidual
        S.base.spectatorSupport S.base.fluctuationSupport anchor domains E V
        S.contourCarrier S.contourEquiv S.K S.coercivity_pos S.mass_pos
        S.K_coercive baseCoarseCovariance layerWord choice D D₃ V₀ Pprop T
        DeltaPi J S.gk
  domainMetric_eq :
    S.domainMetric = cmp116Eq80Lemma1CombinedDomainMetric anchor domains E
  domainCard_eq :
    S.domainCard = cmp116Eq80Lemma1CombinedDomainCard anchor domains E
  domainSupport_eq :
    S.domainSupport = cmp116Eq80Lemma1CombinedDomainSupport anchor domains E
  kernelSupport_eq :
    S.kernelSupport = cmp116Eq80Lemma1CombinedKernelSupport anchor domains E
  E0_eq : S.E0 = E0Direct + lemma1.E0
  threshold_eq : S.threshold = S.epsilon1 / S.gk
  alpha_eq :
    S.alpha =
      cmp116Eq226OptimalInteractionAlpha
        (cmp116Eq220CenteredSourcePotentialRate Finset.univ
          (fun y => (S.domainMetric y : ℝ)) S.domainCard
          S.C3 S.epsilon1 M S.C2 S.kappa1 S.alpha4 S.rowSum)
        (cmp116SourcePi4PhysicalComplexR2BilateralBound
          S.K S.Delta S.Ahead S.rho S.rate S.radius (1 + S.radius))
        S.gamma

