    (choice : CMP99SourcePi4CoarseFineWalkChoice
      M Q S.sourceRange layerWord)
    (lemma1 : CMP109Lemma1Eq136SourceCertificate (q := S.q)
      E V S.gk D S.epsilon1 S.C1 S.C2 S.kappa1 S.delta S.kappa)
    (ledger : CMP116CenteredConditionedCombinedEq80LedgerIdentification
      Dict P Z anchor domains E V baseCoarseCovariance layerWord D D₃ V₀
